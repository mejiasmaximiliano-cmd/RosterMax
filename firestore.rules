rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin(appId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid)).data.get('active', false) == true
        : request.auth.token.get('admin', false) == true
      );
    }

    function validCompensatoryDebt(d) {
      return d.keys().hasOnly(['schemaVersion', 'direction', 'totalUnits', 'settledUnits', 'settlements', 'voided', 'informativeDate', 'note', 'revision', 'lastEventId', 'createdAt', 'updatedAt'])
        && d.schemaVersion == 1 && d.direction in ['company_owes', 'worker_owes']
        && d.totalUnits is int && d.totalUnits >= 1 && d.totalUnits <= 20000
        && d.settledUnits is int && d.settledUnits >= 0 && d.settledUnits <= d.totalUnits
        && d.settlements is map && d.settlements.size() <= 200 && d.voided is bool
        && d.informativeDate is string && d.informativeDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.note is string && d.note.size() <= 500
        && d.revision is int && d.revision >= 1
        && d.lastEventId is string && d.lastEventId.matches('^[A-Za-z0-9_-]{1,80}$')
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }

    function validCompensatoryEvent(e) {
      return e.keys().hasOnly(['schemaVersion', 'debtId', 'kind', 'units', 'previousUnits', 'referenceId', 'informativeDate', 'note', 'revision', 'createdAt'])
        && e.schemaVersion == 1 && e.debtId is string && e.debtId.matches('^[A-Za-z0-9_-]{1,80}$')
        && e.kind in ['open', 'edit', 'settle', 'edit_settlement', 'void_settlement', 'void']
        && e.units is int && e.units >= 0 && e.units <= 20000
        && e.previousUnits is int && e.previousUnits >= 0 && e.previousUnits <= 20000
        && e.referenceId is string && e.referenceId.size() <= 80
        && e.informativeDate is string && e.informativeDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && e.note is string && e.note.size() <= 500
        && e.revision is int && e.revision >= 1 && e.createdAt == request.time;
    }

    function compensatoryCreation(appId, uid, debtId) {
      let d = request.resource.data;
      let e = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/compensatory_entries/$(d.lastEventId)).data;
      return validCompensatoryDebt(d) && !exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/compensatory_entries/$(d.lastEventId))
        && validCompensatoryEvent(e) && e.debtId == debtId && e.kind == 'open'
        && e.revision == 1 && d.revision == 1 && d.createdAt == request.time
        && d.totalUnits == e.units && d.settledUnits == 0 && d.settlements.size() == 0 && d.voided == false
        && d.informativeDate == e.informativeDate && d.note == e.note && e.previousUnits == 0 && e.referenceId == '';
    }

    function compensatoryUpdate(appId, uid, debtId) {
      let d = request.resource.data;
      let old = resource.data;
      let e = getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/compensatory_entries/$(d.lastEventId)).data;
      let common = ['revision', 'lastEventId', 'updatedAt'];
      return validCompensatoryDebt(d) && validCompensatoryEvent(e)
        && !exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/compensatory_entries/$(d.lastEventId))
        && old.voided == false && e.debtId == debtId && e.revision == d.revision && d.revision == old.revision + 1
        && d.createdAt == old.createdAt && d.direction == old.direction
        && (
          (e.kind == 'edit' && d.diff(old).affectedKeys().hasOnly(common.concat(['totalUnits', 'informativeDate', 'note']))
            && e.units == d.totalUnits && e.previousUnits == old.totalUnits && e.units >= old.settledUnits
            && d.informativeDate == e.informativeDate && d.note == e.note && e.referenceId == '')
          || (e.kind == 'void' && d.diff(old).affectedKeys().hasOnly(common.concat(['voided']))
            && old.settledUnits == 0 && old.settlements.size() == 0 && d.voided == true && e.units == 0 && e.previousUnits == old.totalUnits && e.referenceId == '')
          || (e.kind == 'settle' && d.diff(old).affectedKeys().hasOnly(common.concat(['settledUnits', 'settlements']))
            && e.referenceId == d.lastEventId && e.units > 0 && e.previousUnits == 0 && !old.settlements.keys().hasAny([e.referenceId])
            && d.settlements.diff(old.settlements).affectedKeys().hasOnly([e.referenceId]) && d.settlements.get(e.referenceId, 0) == e.units
            && d.settledUnits == old.settledUnits + e.units)
          || (e.kind in ['edit_settlement', 'void_settlement'] && d.diff(old).affectedKeys().hasOnly(common.concat(['settledUnits', 'settlements']))
            && e.previousUnits > 0 && old.settlements.get(e.referenceId, 0) == e.previousUnits
            && d.settlements.diff(old.settlements).affectedKeys().hasOnly([e.referenceId])
            && ((e.kind == 'void_settlement' && e.units == 0 && !d.settlements.keys().hasAny([e.referenceId]))
              || (e.kind == 'edit_settlement' && e.units > 0 && d.settlements.get(e.referenceId, 0) == e.units))
            && d.settledUnits == old.settledUnits + e.units - e.previousUnits)
        );
    }

    // El documento compartido contiene disponibilidad, nunca el motivo de
    // una licencia, un diagnóstico ni notas privadas. Formato wire v1:
    // N/R/W|inicio|fin o C|inicio|fin|trabajo|descanso|inicioCiclo.
    // Tokens fijos permiten validar 30 cambios dentro del límite de expresiones.
    function validSharedException(data) {
      return data.matches('^([NRW][|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])|C[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$');
    }

    function validSharedExceptions(items) {
      let count = items.size();
      return items is list && count <= 30
        && (count <= 0 ? true : validSharedException(items[0]))
        && (count <= 1 ? true : validSharedException(items[1]))
        && (count <= 2 ? true : validSharedException(items[2]))
        && (count <= 3 ? true : validSharedException(items[3]))
        && (count <= 4 ? true : validSharedException(items[4]))
        && (count <= 5 ? true : validSharedException(items[5]))
        && (count <= 6 ? true : validSharedException(items[6]))
        && (count <= 7 ? true : validSharedException(items[7]))
        && (count <= 8 ? true : validSharedException(items[8]))
        && (count <= 9 ? true : validSharedException(items[9]))
        && (count <= 10 ? true : validSharedException(items[10]))
        && (count <= 11 ? true : validSharedException(items[11]))
        && (count <= 12 ? true : validSharedException(items[12]))
        && (count <= 13 ? true : validSharedException(items[13]))
        && (count <= 14 ? true : validSharedException(items[14]))
        && (count <= 15 ? true : validSharedException(items[15]))
        && (count <= 16 ? true : validSharedException(items[16]))
        && (count <= 17 ? true : validSharedException(items[17]))
        && (count <= 18 ? true : validSharedException(items[18]))
        && (count <= 19 ? true : validSharedException(items[19]))
        && (count <= 20 ? true : validSharedException(items[20]))
        && (count <= 21 ? true : validSharedException(items[21]))
        && (count <= 22 ? true : validSharedException(items[22]))
        && (count <= 23 ? true : validSharedException(items[23]))
        && (count <= 24 ? true : validSharedException(items[24]))
        && (count <= 25 ? true : validSharedException(items[25]))
        && (count <= 26 ? true : validSharedException(items[26]))
        && (count <= 27 ? true : validSharedException(items[27]))
        && (count <= 28 ? true : validSharedException(items[28]))
        && (count <= 29 ? true : validSharedException(items[29]));
    }

    function analyticsConsent(appId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)/settings/privacy).data.get('analyticsEnabled', false) == true;
    }

    // El sufijo se compara literalmente: no interpolamos UID en una regex.
    // Así la primera transacción puede leer SU documento aún inexistente.
    function ownsMetricId(metricId) {
      let suffix = '_' + request.auth.uid;
      let prefixSize = metricId.size() - suffix.size();
      return signedIn() && prefixSize >= 1 && prefixSize <= 100
        && metricId[prefixSize:metricId.size()] == suffix;
    }

    function ownsFeatureId(eventId) {
      let prefix = request.auth.uid + '_';
      return signedIn() && eventId.size() > prefix.size()
        && eventId[0:prefix.size()] == prefix
        && eventId[prefix.size():eventId.size()].matches('^[A-Za-z0-9_-]{1,80}$');
    }

    function validSharedRoster(data, code, appId) {
      let syncPath = /databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)/settings/sync;
      return data.keys().hasOnly([
          'ownerUid', 'syncCode', 'name', 'workDays', 'restDays', 'startDate', 'exceptions', 'history', 'updatedAt'
        ])
        && data.ownerUid == request.auth.uid
        && (!exists(syncPath) || (getAfter(syncPath).data.get('enabled', true) == true && getAfter(syncPath).data.code == code))
        && data.syncCode == code
        && code.matches('^RM-[A-Z0-9]{8}$')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.workDays is int
        && data.workDays >= 1
        && data.workDays <= 365
        && data.restDays is int
        && data.restDays >= 1
        && data.restDays <= 365
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!data.keys().hasAny(['exceptions']) || validSharedExceptions(data.exceptions))
        && (!data.keys().hasAny(['history']) || (data.history is string && data.history.size() <= 2000
          && data.history.matches('^B[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|][0-9]{4}-[0-9]{2}-[0-9]{2}(;P[|][0-9]{4}-[0-9]{2}-[0-9]{2}[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|][0-9]{4}-[0-9]{2}-[0-9]{2}){0,20}$')))
        && data.updatedAt == request.time;
    }

    function sharingActive(appId, ownerUid, code) {
      let p = /databases/$(database)/documents/artifacts/$(appId)/users/$(ownerUid)/settings/sync;
      return !exists(p) || (get(p).data.get('enabled', true) == true && get(p).data.code == code);
    }

    function validActivity(data, userId) {
      return data.keys().hasOnly([
          'ownerUid', 'accountType', 'firstSeenAt', 'lastActiveAt', 'lastActiveDay',
          'installDetected', 'rosterConfigured', 'profileComplete', 'appVersion'
        ])
        && data.ownerUid == request.auth.uid
        && userId == request.auth.uid
        && data.accountType in ['guest', 'google']
        && data.firstSeenAt is timestamp
        && data.lastActiveAt == request.time
        && data.lastActiveDay is string && data.lastActiveDay.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.installDetected is bool
        && data.rosterConfigured is bool
        && data.profileComplete is bool
        && data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 30;
    }

    function validCampaignMetric(data, metricId, appId) {
      return data.keys().hasOnly([
          'ownerUid', 'campaignId', 'views', 'clicks', 'firstViewAt', 'lastEventAt'
        ])
        && data.ownerUid == request.auth.uid
        && data.campaignId is string && data.campaignId.size() > 0 && data.campaignId.size() <= 100
        && metricId == data.campaignId + '_' + request.auth.uid
        && data.views is int && data.views >= 0
        && data.clicks is int && data.clicks >= 0
        && data.firstViewAt is timestamp
        && data.lastEventAt == request.time
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/ads/$(data.campaignId)).data.active == true;
    }

    function validCensusCount(value) {
      return value is int && value >= 0 && value <= 1000000000;
    }

    function validAccountCensus(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'source', 'projectId', 'generatedAt',
          'totalAccounts', 'registeredAccounts', 'guestAccounts', 'googleAccounts', 'disabledAccounts',
          'createdLast7Days', 'createdLast30Days', 'signInsLast24Hours', 'signInsLast7Days', 'signInsLast30Days'
          , 'createdLast24Hours', 'createdRegisteredLast24Hours', 'createdGuestLast24Hours',
          'createdRegisteredLast7Days', 'createdGuestLast7Days', 'createdRegisteredLast30Days', 'createdGuestLast30Days'
        ])
        && data.schemaVersion == 1 && data.source == 'firebase-auth' && data.projectId == request.auth.token.aud
        && data.generatedAt == request.time
        && validCensusCount(data.totalAccounts)
        && validCensusCount(data.registeredAccounts) && validCensusCount(data.guestAccounts)
        && validCensusCount(data.googleAccounts) && validCensusCount(data.disabledAccounts)
        && validCensusCount(data.createdLast7Days) && validCensusCount(data.createdLast30Days)
        && validCensusCount(data.signInsLast24Hours) && validCensusCount(data.signInsLast7Days) && validCensusCount(data.signInsLast30Days)
        && data.registeredAccounts + data.guestAccounts == data.totalAccounts
        && data.googleAccounts <= data.registeredAccounts && data.disabledAccounts <= data.totalAccounts
        && data.createdLast7Days <= data.createdLast30Days && data.createdLast30Days <= data.totalAccounts
        && data.signInsLast24Hours <= data.signInsLast7Days
        && data.signInsLast7Days <= data.signInsLast30Days && data.signInsLast30Days <= data.totalAccounts
        && (!data.keys().hasAny(['createdLast24Hours', 'createdRegisteredLast24Hours', 'createdGuestLast24Hours', 'createdRegisteredLast7Days', 'createdGuestLast7Days', 'createdRegisteredLast30Days', 'createdGuestLast30Days'])
          || (validCensusCount(data.createdLast24Hours) && validCensusCount(data.createdRegisteredLast24Hours) && validCensusCount(data.createdGuestLast24Hours)
            && validCensusCount(data.createdRegisteredLast7Days) && validCensusCount(data.createdGuestLast7Days)
            && validCensusCount(data.createdRegisteredLast30Days) && validCensusCount(data.createdGuestLast30Days)
            && data.createdRegisteredLast24Hours + data.createdGuestLast24Hours == data.createdLast24Hours
            && data.createdRegisteredLast7Days + data.createdGuestLast7Days == data.createdLast7Days
            && data.createdRegisteredLast30Days + data.createdGuestLast30Days == data.createdLast30Days
            && data.createdLast24Hours <= data.createdLast7Days
            && data.createdRegisteredLast24Hours <= data.createdRegisteredLast7Days && data.createdRegisteredLast7Days <= data.createdRegisteredLast30Days
            && data.createdGuestLast24Hours <= data.createdGuestLast7Days && data.createdGuestLast7Days <= data.createdGuestLast30Days));
    }

    function validAd(data) {
      return data.keys().hasAll([
          'company', 'title', 'location', 'cta', 'url', 'startDate', 'endDate',
          'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'company', 'title', 'location', 'cta', 'url', 'startDate', 'endDate',
          'active', 'createdBy', 'createdAt', 'updatedAt', 'pausedAt'
        ])
        && data.company is string && data.company.size() > 0 && data.company.size() <= 80
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.location is string && data.location.size() > 0 && data.location.size() <= 80
        && data.cta is string && data.cta.size() > 0 && data.cta.size() <= 30
        && data.url is string && data.url.size() <= 500 && data.url.matches('^https://.*')
        && data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startDate <= data.endDate
        && data.active is bool
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFeedback(data) {
      return data.keys().hasOnly(['ownerUid', 'name', 'category', 'message', 'status', 'createdAt'])
        && data.ownerUid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.category is string && data.category.size() > 0 && data.category.size() <= 20
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 800
        && data.status == 'new'
        && data.createdAt is timestamp;
    }

    function validReciprocalFriend(data, appId, userId, friendId) {
      return signedIn()
        && friendId == request.auth.uid
        && data.keys().hasOnly([
          'name', 'friendUid', 'syncCode', 'isSynced', 'reciprocal', 'inviteCode', 'createdAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.friendUid == request.auth.uid
        && data.syncCode is string && data.syncCode.matches('^RM-[A-Z0-9]{8}$')
        && data.isSynced == true
        && data.reciprocal == true
        && data.inviteCode is string && data.inviteCode.matches('^RM-[A-Z0-9]{8}$')
        && data.inviteCode != data.syncCode
        && data.createdAt == request.time
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(data.inviteCode)).data.ownerUid == userId
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(data.syncCode)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)/friends/$(userId)).data.friendUid == userId;
    }

    match /artifacts/{appId} {
      // El registro de administradores se crea únicamente desde la consola o
      // un entorno servidor. Cada usuario solo puede comprobar su propio rol.
      match /admins/{userId} {
        allow get: if owns(userId);
        allow list, create, update, delete: if false;
      }

      // Censo de cuentas procedente de una consulta administrativa completa.
      // No contiene identidades ni reemplaza la medición opcional de actividad.
      match /admin_stats/accounts {
        allow get: if isAdmin(appId);
        allow create, update: if isAdmin(appId) && validAccountCensus(request.resource.data);
        allow list, delete: if false;
      }

      // Quien acepta un enlace solo puede insertar su propio roster público
      // en la lista del remitente. No obtiene lectura del espacio privado ni
      // puede representar a otro usuario.
      match /users/{userId}/friends/{friendId} {
        allow get: if signedIn() && friendId == request.auth.uid
          && (!exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/friends/$(friendId))
            || (resource.data.get('friendUid', '') == request.auth.uid
              && resource.data.get('isSynced', false) == true
              && resource.data.keys().hasOnly(['name', 'friendUid', 'syncCode', 'isSynced', 'reciprocal', 'inviteCode', 'createdAt'])));
        allow create: if validReciprocalFriend(request.resource.data, appId, userId, friendId);
        // Reaceptar no autoriza a reemplazar una conexión editada por su dueño.
        allow update: if signedIn() && friendId == request.auth.uid
          && resource.data.get('friendUid', '') == request.auth.uid
          && resource.data.get('reciprocal', false) == true
          && request.resource.data == resource.data;
      }

      // Cada usuario solo puede leer y modificar su propio espacio privado.
      match /users/{userId}/{collectionId}/{document=**} {
        allow read, write: if owns(userId) && !(collectionId in ['compensatory_debts', 'compensatory_entries']);
      }

      match /users/{userId}/compensatory_debts/{debtId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && debtId.matches('^[A-Za-z0-9_-]{1,80}$') && compensatoryCreation(appId, userId, debtId);
        allow update: if owns(userId) && compensatoryUpdate(appId, userId, debtId);
        allow delete: if false;
      }

      match /users/{userId}/compensatory_entries/{entryId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && entryId.matches('^[A-Za-z0-9_-]{1,80}$')
          && validCompensatoryEvent(request.resource.data)
          && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/compensatory_debts/$(request.resource.data.debtId)).data.lastEventId == entryId
          && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/compensatory_debts/$(request.resource.data.debtId)).data.revision == request.resource.data.revision
          && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/compensatory_debts/$(request.resource.data.debtId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }

      // Un código compartido permite leer un roster exacto, pero nunca listar
      // ni enumerar todos los códigos o trabajadores.
      match /public/data/sync_codes/{code} {
        allow get: if signedIn() && (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(code))
          || sharingActive(appId, resource.data.ownerUid, code));
        allow list: if false;
        allow create, update: if signedIn()
          && (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(code)) || resource.data.ownerUid == request.auth.uid)
          && validSharedRoster(request.resource.data, code, appId);
        allow delete: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || isAdmin(appId));
      }

      // Todos los usuarios autenticados pueden ver campañas, pero solamente
      // una identidad registrada como administradora puede administrarlas.
      match /public/data/ads/{adId} {
        allow read: if signedIn();
        allow create: if isAdmin(appId) && validAd(request.resource.data);
        allow update, delete: if isAdmin(appId);
      }

      // Los participantes de la beta pueden enviar comentarios sin exponer
      // una lista pública. Solo el administrador puede leerlos o moderarlos.
      match /public/data/feedback/{feedbackId} {
        allow create: if signedIn() && validFeedback(request.resource.data);
        allow read, delete: if isAdmin(appId);
        allow update: if isAdmin(appId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['new', 'in_progress', 'resolved']
          && request.resource.data.updatedAt == request.time;
      }

      // El usuario participa sólo si activa la medición. Puede consultar o
      // borrar su propio registro; el administrador recibe únicamente datos
      // técnicos seudónimos (vinculados a UID), sin contenido privado.
      match /public/data/activity/{userId} {
        allow get: if owns(userId) || isAdmin(appId);
        allow list: if isAdmin(appId);
        allow create: if owns(userId) && analyticsConsent(appId)
          && validActivity(request.resource.data, userId)
          && request.resource.data.firstSeenAt == request.time;
        allow update: if owns(userId)
          && analyticsConsent(appId)
          && validActivity(request.resource.data, userId)
          && request.resource.data.firstSeenAt == resource.data.firstSeenAt;
        allow delete: if owns(userId) || isAdmin(appId);
      }

      // Immutable minimal operation metadata. No private record content.
      match /public/data/feature_events/{eventId} {
        allow get: if isAdmin(appId) || ownsFeatureId(eventId);
        allow list: if isAdmin(appId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if signedIn() && analyticsConsent(appId)
          && request.resource.data.keys().hasOnly(['ownerUid', 'type', 'occurredAt', 'recordedAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && ownsFeatureId(eventId)
          && request.resource.data.type in ['roster_configured', 'invitation_accepted', 'plan_saved', 'expense_recorded', 'goal_created', 'compensatory_recorded']
          && request.resource.data.occurredAt is timestamp && request.resource.data.occurredAt <= request.time
          && request.resource.data.occurredAt >= getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)/settings/privacy).data.updatedAt
          && request.resource.data.recordedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(appId));
      }

      match /admin_audit/{eventId} {
        allow read: if isAdmin(appId);
        allow create: if isAdmin(appId)
          && request.resource.data.keys().hasOnly(['actorUid', 'action', 'targetId', 'createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action in ['census_refreshed', 'campaign_created', 'campaign_paused', 'feedback_status']
          && request.resource.data.targetId is string && request.resource.data.targetId.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Una campaña guarda un documento agregado por usuario. Los contadores
      // sólo pueden avanzar de a un evento; el panel CEO ve el agregado.
      match /public/data/campaign_metrics/{metricId} {
        allow get: if signedIn() && (isAdmin(appId)
          || (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/campaign_metrics/$(metricId)) && ownsMetricId(metricId))
          || (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/campaign_metrics/$(metricId)) && resource.data.ownerUid == request.auth.uid));
        allow list: if isAdmin(appId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if signedIn() && analyticsConsent(appId)
          && validCampaignMetric(request.resource.data, metricId, appId)
          && request.resource.data.firstViewAt == request.time
          && request.resource.data.views + request.resource.data.clicks == 1;
        allow update: if signedIn()
          && analyticsConsent(appId)
          && resource.data.ownerUid == request.auth.uid
          && validCampaignMetric(request.resource.data, metricId, appId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.campaignId == resource.data.campaignId
          && request.resource.data.firstViewAt == resource.data.firstViewAt
          && request.resource.data.views >= resource.data.views
          && request.resource.data.views <= resource.data.views + 1
          && request.resource.data.clicks >= resource.data.clicks
          && request.resource.data.clicks <= resource.data.clicks + 1
          && request.resource.data.views + request.resource.data.clicks == resource.data.views + resource.data.clicks + 1;
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(appId));
      }

      // Bloquea el registro global usado por versiones anteriores.
      match /public/data/users_registry/{userId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
