rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin(appId) {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || (
          exists(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/artifacts/$(appId)/admins/$(request.auth.uid)).data.get('active', false) == true
        )
      );
    }

    // El documento compartido contiene disponibilidad, nunca el motivo de
    // una licencia, un diagnóstico ni notas privadas. Formato wire v1:
    // N/R/W|inicio|fin o C|inicio|fin|trabajo|descanso|inicioCiclo.
    // Tokens fijos permiten validar 30 cambios dentro del límite de expresiones.
    function validSharedException(data) {
      return data.matches('^([NRW][|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])|C[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|]([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])[|][0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))$');
    }

    function validSharedExceptions(items) {
      let count = items.size();
      return items is list && count <= 30
        && (count <= 0 ? true : validSharedException(items[0]))
        && (count <= 1 ? true : validSharedException(items[1]))
        && (count <= 2 ? true : validSharedException(items[2]))
        && (count <= 3 ? true : validSharedException(items[3]))
        && (count <= 4 ? true : validSharedException(items[4]))
        && (count <= 5 ? true : validSharedException(items[5]))
        && (count <= 6 ? true : validSharedException(items[6]))
        && (count <= 7 ? true : validSharedException(items[7]))
        && (count <= 8 ? true : validSharedException(items[8]))
        && (count <= 9 ? true : validSharedException(items[9]))
        && (count <= 10 ? true : validSharedException(items[10]))
        && (count <= 11 ? true : validSharedException(items[11]))
        && (count <= 12 ? true : validSharedException(items[12]))
        && (count <= 13 ? true : validSharedException(items[13]))
        && (count <= 14 ? true : validSharedException(items[14]))
        && (count <= 15 ? true : validSharedException(items[15]))
        && (count <= 16 ? true : validSharedException(items[16]))
        && (count <= 17 ? true : validSharedException(items[17]))
        && (count <= 18 ? true : validSharedException(items[18]))
        && (count <= 19 ? true : validSharedException(items[19]))
        && (count <= 20 ? true : validSharedException(items[20]))
        && (count <= 21 ? true : validSharedException(items[21]))
        && (count <= 22 ? true : validSharedException(items[22]))
        && (count <= 23 ? true : validSharedException(items[23]))
        && (count <= 24 ? true : validSharedException(items[24]))
        && (count <= 25 ? true : validSharedException(items[25]))
        && (count <= 26 ? true : validSharedException(items[26]))
        && (count <= 27 ? true : validSharedException(items[27]))
        && (count <= 28 ? true : validSharedException(items[28]))
        && (count <= 29 ? true : validSharedException(items[29]));
    }

    function analyticsConsent(appId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)/settings/privacy).data.get('analyticsEnabled', false) == true;
    }

    // El sufijo se compara literalmente: no interpolamos UID en una regex.
    // Así la primera transacción puede leer SU documento aún inexistente.
    function ownsMetricId(metricId) {
      let suffix = '_' + request.auth.uid;
      let prefixSize = metricId.size() - suffix.size();
      return signedIn() && prefixSize >= 1 && prefixSize <= 100
        && metricId[prefixSize:metricId.size()] == suffix;
    }

    function validSharedRoster(data, code) {
      return data.keys().hasOnly([
          'ownerUid', 'syncCode', 'name', 'workDays', 'restDays', 'startDate', 'exceptions', 'updatedAt'
        ])
        && data.ownerUid == request.auth.uid
        && data.syncCode == code
        && code.matches('^RM-[A-Z0-9]{8}$')
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.workDays is int
        && data.workDays >= 1
        && data.workDays <= 365
        && data.restDays is int
        && data.restDays >= 1
        && data.restDays <= 365
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!data.keys().hasAny(['exceptions']) || validSharedExceptions(data.exceptions))
        && data.updatedAt == request.time;
    }

    function validActivity(data, userId) {
      return data.keys().hasOnly([
          'ownerUid', 'accountType', 'firstSeenAt', 'lastActiveAt', 'lastActiveDay',
          'installDetected', 'rosterConfigured', 'profileComplete', 'appVersion'
        ])
        && data.ownerUid == request.auth.uid
        && userId == request.auth.uid
        && data.accountType in ['guest', 'google']
        && data.firstSeenAt is timestamp
        && data.lastActiveAt == request.time
        && data.lastActiveDay is string && data.lastActiveDay.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.installDetected is bool
        && data.rosterConfigured is bool
        && data.profileComplete is bool
        && data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 30;
    }

    function validCampaignMetric(data, metricId, appId) {
      return data.keys().hasOnly([
          'ownerUid', 'campaignId', 'views', 'clicks', 'firstViewAt', 'lastEventAt'
        ])
        && data.ownerUid == request.auth.uid
        && data.campaignId is string && data.campaignId.size() > 0 && data.campaignId.size() <= 100
        && metricId == data.campaignId + '_' + request.auth.uid
        && data.views is int && data.views >= 0
        && data.clicks is int && data.clicks >= 0
        && data.firstViewAt is timestamp
        && data.lastEventAt == request.time
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/ads/$(data.campaignId)).data.active == true;
    }

    function validAd(data) {
      return data.keys().hasAll([
          'company', 'title', 'location', 'cta', 'url', 'startDate', 'endDate',
          'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'company', 'title', 'location', 'cta', 'url', 'startDate', 'endDate',
          'active', 'createdBy', 'createdAt', 'updatedAt', 'pausedAt'
        ])
        && data.company is string && data.company.size() > 0 && data.company.size() <= 80
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.location is string && data.location.size() > 0 && data.location.size() <= 80
        && data.cta is string && data.cta.size() > 0 && data.cta.size() <= 30
        && data.url is string && data.url.size() <= 500 && data.url.matches('^https://.*')
        && data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startDate <= data.endDate
        && data.active is bool
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validFeedback(data) {
      return data.keys().hasOnly(['ownerUid', 'name', 'category', 'message', 'status', 'createdAt'])
        && data.ownerUid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.category is string && data.category.size() > 0 && data.category.size() <= 20
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 800
        && data.status == 'new'
        && data.createdAt is timestamp;
    }

    function validReciprocalFriend(data, appId, userId, friendId) {
      return signedIn()
        && friendId == request.auth.uid
        && data.keys().hasOnly([
          'name', 'friendUid', 'syncCode', 'isSynced', 'reciprocal', 'inviteCode', 'createdAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.friendUid == request.auth.uid
        && data.syncCode is string && data.syncCode.matches('^RM-[A-Z0-9]{8}$')
        && data.isSynced == true
        && data.reciprocal == true
        && data.inviteCode is string && data.inviteCode.matches('^RM-[A-Z0-9]{8}$')
        && data.inviteCode != data.syncCode
        && data.createdAt == request.time
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(data.inviteCode)).data.ownerUid == userId
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(data.syncCode)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/artifacts/$(appId)/users/$(request.auth.uid)/friends/$(userId)).data.friendUid == userId;
    }

    match /artifacts/{appId} {
      // El registro de administradores se crea únicamente desde la consola o
      // un entorno servidor. Cada usuario solo puede comprobar su propio rol.
      match /admins/{userId} {
        allow get: if owns(userId);
        allow list, create, update, delete: if false;
      }

      // Quien acepta un enlace solo puede insertar su propio roster público
      // en la lista del remitente. No obtiene lectura del espacio privado ni
      // puede representar a otro usuario.
      match /users/{userId}/friends/{friendId} {
        allow get: if signedIn() && friendId == request.auth.uid
          && (!exists(/databases/$(database)/documents/artifacts/$(appId)/users/$(userId)/friends/$(friendId))
            || (resource.data.get('friendUid', '') == request.auth.uid
              && resource.data.get('isSynced', false) == true
              && resource.data.keys().hasOnly(['name', 'friendUid', 'syncCode', 'isSynced', 'reciprocal', 'inviteCode', 'createdAt'])));
        allow create: if validReciprocalFriend(request.resource.data, appId, userId, friendId);
        // Reaceptar no autoriza a reemplazar una conexión editada por su dueño.
        allow update: if signedIn() && friendId == request.auth.uid
          && resource.data.get('friendUid', '') == request.auth.uid
          && resource.data.get('reciprocal', false) == true
          && request.resource.data == resource.data;
      }

      // Cada usuario solo puede leer y modificar su propio espacio privado.
      match /users/{userId}/{document=**} {
        allow read, write: if owns(userId);
      }

      // Un código compartido permite leer un roster exacto, pero nunca listar
      // ni enumerar todos los códigos o trabajadores.
      match /public/data/sync_codes/{code} {
        allow get: if signedIn();
        allow list: if false;
        allow create, update: if signedIn()
          && (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/sync_codes/$(code)) || resource.data.ownerUid == request.auth.uid)
          && validSharedRoster(request.resource.data, code);
        allow delete: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || isAdmin(appId));
      }

      // Todos los usuarios autenticados pueden ver campañas, pero solamente
      // una identidad registrada como administradora puede administrarlas.
      match /public/data/ads/{adId} {
        allow read: if signedIn();
        allow create: if isAdmin(appId) && validAd(request.resource.data);
        allow update, delete: if isAdmin(appId);
      }

      // Los participantes de la beta pueden enviar comentarios sin exponer
      // una lista pública. Solo el administrador puede leerlos o moderarlos.
      match /public/data/feedback/{feedbackId} {
        allow create: if signedIn() && validFeedback(request.resource.data);
        allow read, update, delete: if isAdmin(appId);
      }

      // El usuario participa sólo si activa la medición. Puede consultar o
      // borrar su propio registro; el administrador recibe únicamente datos
      // técnicos seudónimos (vinculados a UID), sin contenido privado.
      match /public/data/activity/{userId} {
        allow get: if owns(userId) || isAdmin(appId);
        allow list: if isAdmin(appId);
        allow create: if owns(userId) && analyticsConsent(appId)
          && validActivity(request.resource.data, userId)
          && request.resource.data.firstSeenAt == request.time;
        allow update: if owns(userId)
          && analyticsConsent(appId)
          && validActivity(request.resource.data, userId)
          && request.resource.data.firstSeenAt == resource.data.firstSeenAt;
        allow delete: if owns(userId) || isAdmin(appId);
      }

      // Una campaña guarda un documento agregado por usuario. Los contadores
      // sólo pueden avanzar de a un evento; el panel CEO ve el agregado.
      match /public/data/campaign_metrics/{metricId} {
        allow get: if signedIn() && (isAdmin(appId)
          || (!exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/campaign_metrics/$(metricId)) && ownsMetricId(metricId))
          || (exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/campaign_metrics/$(metricId)) && resource.data.ownerUid == request.auth.uid));
        allow list: if isAdmin(appId);
        allow create: if signedIn() && analyticsConsent(appId)
          && validCampaignMetric(request.resource.data, metricId, appId)
          && request.resource.data.firstViewAt == request.time
          && request.resource.data.views + request.resource.data.clicks == 1;
        allow update: if signedIn()
          && analyticsConsent(appId)
          && resource.data.ownerUid == request.auth.uid
          && validCampaignMetric(request.resource.data, metricId, appId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.campaignId == resource.data.campaignId
          && request.resource.data.firstViewAt == resource.data.firstViewAt
          && request.resource.data.views >= resource.data.views
          && request.resource.data.views <= resource.data.views + 1
          && request.resource.data.clicks >= resource.data.clicks
          && request.resource.data.clicks <= resource.data.clicks + 1
          && request.resource.data.views + request.resource.data.clicks == resource.data.views + resource.data.clicks + 1;
        allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin(appId));
      }

      // Bloquea el registro global usado por versiones anteriores.
      match /public/data/users_registry/{userId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
